{
  "name": "semantic-cache-js",
  "version": "1.0.0",
  "description": "A production-ready semantic caching library for OpenAI, Anthropic, Gemini, and other LLM providers",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "demo": "node scripts/demo.js",
    "demo:simulate": "node scripts/demo.js --simulate",
    "test": "node --test tests/**/*.test.js",
    "benchmark:without": "node benchmark/without-cache.js",
    "benchmark:with": "node benchmark/with-cache.js",
    "benchmark": "npm run benchmark:without && npm run benchmark:with"
  },
  "keywords": [
    "semantic-cache",
    "llm",
    "openai",
    "redis",
    "embeddings",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
